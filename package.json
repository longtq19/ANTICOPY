{
  "name": "lan-customer-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Quản lý & hiển thị danh sách khách hàng trong mạng LAN, bảo vệ số điện thoại nhiều lớp",
  "type": "module",
  "scripts": {
